# Copy to .env.localdev / .env.cloud (or edit those files directly).
# Vite loads .env.[mode] when you pass --mode.
#
#   npm run dev:local   → .env.localdev
#   npm run dev:cloud   → .env.cloud
#
# Local anon key is the fixed demo key from `supabase status`.
# Cloud values come from your Supabase project settings (anon / publishable key).

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
