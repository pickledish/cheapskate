{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"console.error('Specify a backend: npm run dev:local  or  npm run dev:cloud'); process.exit(1)\"",
    "dev:local": "vite --mode localdev",
    "dev:cloud": "vite --mode cloud",
    "build": "vue-tsc -b && vite build",
    "preview": "node -e \"console.error('Specify a backend: npm run preview:local  or  npm run preview:cloud'); process.exit(1)\"",
    "preview:local": "vite build --mode localdev && vite preview --port 5173 --strictPort",
    "preview:cloud": "vite build --mode cloud && vite preview --port 5173 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "lint-fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier --check \"**/*.{ts,vue}\"",
    "format-fix": "prettier --check \"**/*.{ts,vue}\" --write",
    "seed": "node -e \"console.error('Specify a backend: npm run seed:local  or  npm run seed:cloud'); process.exit(1)\"",
    "seed:local": "vite-node --mode localdev scripts/seed-demo.ts",
    "seed:cloud": "vite-node --mode cloud scripts/seed-demo.ts",
    "fetch-institution-icons": "vite-node scripts/fetch-institution-icons.ts"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "dayjs": "^1.11.19",
    "echarts": "^5.6.0",
    "pdfjs-dist": "5.4.624",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.24",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.7",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.4",
    "vite-node": "^6.0.0",
    "vue-tsc": "^3.1.4"
  }
}
